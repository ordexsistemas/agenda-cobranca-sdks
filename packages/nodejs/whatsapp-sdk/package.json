{
  "name": "@ordexsistemas/whatsapp-sdk",
  "version": "0.2.1",
  "description": "SDK WhatsApp Cloud API (add-on SaaS Ordex Pay) com medição por categoria e controle de quantidade de cobranças na Agenda Financeira",
  "license": "MIT",
  "author": "Ordex Sistemas",
  "homepage": "https://github.com/ordexsistemas/agenda-cobranca-sdks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordexsistemas/agenda-cobranca-sdks.git",
    "directory": "packages/nodejs/whatsapp-sdk"
  },
  "bugs": {
    "url": "https://github.com/ordexsistemas/agenda-cobranca-sdks/issues"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-cloud-api",
    "ordex",
    "ordex-pay",
    "saas",
    "metering",
    "agenda",
    "cobranca"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
